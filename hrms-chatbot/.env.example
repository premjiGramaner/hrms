# ── Node.js HRMS server (the existing backend — all data comes from here) ────
HRMS_API_BASE_URL=http://localhost:5001

# ── JWT — MUST match the Node.js server JWT_SECRET exactly ──────────────────
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256

# ── Hugging Face NLP ─────────────────────────────────────────────────────────
HF_MODEL_NAME=cross-encoder/nli-distilroberta-base
INTENT_CONFIDENCE_THRESHOLD=0.75
FINE_TUNED_MODEL_PATH=   # leave empty to use zero-shot

# ── Session (optional Redis — uses in-memory if blank) ───────────────────────
REDIS_URL=
SESSION_TTL_SECONDS=1800

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
