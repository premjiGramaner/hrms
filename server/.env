NODE_ENV=development
PORT=5001
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REMEMBER_ME_DURATION=30d

# Database Configuration
# Format: postgres://username:password@host:port/database
# Make sure to URL-encode special characters in password
# UPDATE: Replace with your actual PostgreSQL credentials
DATABASE_URL=postgres://postgres:root@localhost:5432/hrms

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=root

SMTP_USER=prashanthv6777@gmail.com
SMTP_PASS=ujddxupefwfpxxql
MAIL_FROM=prashanthv6777@gmail.com

# Configurable legacy leave conversion (Excel hours per requested day)
LEAVE_MIGRATION_HOURS_PER_DAY=8
LEAVE_MIGRATION_DATE_ORDER=DMY
DEFAULT_PASSWORD=admin!@123

# Microsoft Azure AD Configuration
# Get these from Azure Portal: https://portal.azure.com
# 1. Go to Azure Active Directory > App registrations
# 2. Create a new registration or use existing one
# 3. Copy Application (client) ID and Directory (tenant) ID
# 4. Create a client secret under Certificates & secrets
AZURE_AD_CLIENT_ID=00000002-0000-0000-c000-000000000000
AZURE_AD_TENANT_ID=676756b5-b237-4f5b-a6ea-e195b3fa5e11
AZURE_AD_CLIENT_SECRET=your-azure-client-secret-here
AZURE_AD_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback
AZURE_AD_ALLOWED_DOMAIN=cannyfore.com

# Enable Azure AD authentication for username/password login
# When enabled, username/password input fields will authenticate against Azure AD first
# If Azure AD fails, it will fallback to local database authentication
# Options: true | false (default: true if Azure AD is configured)
AZURE_AD_PASSWORD_AUTH_ENABLED=true
